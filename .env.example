# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically; for host runs
# (`uv run ...`) export the variables yourself, e.g.  set -a; source .env; set +a
# Every value has a default in supervisor_middleware/config.py, so an empty .env works offline.

# --- Executor (Anthropic) -----------------------------------------------------------------------------------
# Needed only for EXECUTOR_BACKEND=anthropic (or auto with a key present).
ANTHROPIC_API_KEY=
# Model for the executor. The plan named Claude 3.5 Sonnet (retired); current Sonnet is the default.
EXECUTOR_MODEL=claude-sonnet-5-5
# auto      = anthropic if ANTHROPIC_API_KEY is set, else scripted
# anthropic = real streaming API calls
# scripted  = deterministic offline token stream (executor/scripted.py), no network
EXECUTOR_BACKEND=auto
# Max ProposeAction steps per episode.
EXECUTOR_MAX_STEPS=12
# Max output tokens per executor generation.
EXECUTOR_MAX_TOKENS=8000
# After a generation finishes, seconds the tool node waits for a late supervisor verdict before running the command.
VERDICT_GRACE_S=3.0

# --- Supervisor (local Qwen via Ollama) ---------------------------------------------------------------------
# ollama = ask the local model; rules = deterministic regex judge (offline)
SUPERVISOR_BACKEND=ollama
SUPERVISOR_MODEL=qwen2.5:3b-instruct
# Seconds before a supervisor model call is abandoned.
SUPERVISOR_TIMEOUT_S=30
# Where the supervisor reaches Ollama.
#   host runs (uv run):            http://localhost:11434            (config.py default)
#   compose, ollama container:     http://ollama:11434               (compose default)
#   compose + host-ollama override: http://host.docker.internal:11434 (set by docker-compose.host-ollama.yml)
# Leave commented unless you need to override: compose interpolates this into the supervisor container, so a
# localhost value here would break the containerised supervisor.
# OLLAMA_URL=http://localhost:11434

# --- Redis --------------------------------------------------------------------------------------------------
# Host runs use localhost (published on 127.0.0.1:6379 by `docker compose up -d redis`); compose services always
# use redis://redis:6379/0 regardless of this value.
REDIS_URL=redis://localhost:6379/0
# Channel names (rarely changed; both sides must agree).
# EXECUTOR_CHANNEL=executor_stream
# INTERRUPT_CHANNEL=supervisor_interrupts

# --- Telemetry ----------------------------------------------------------------------------------------------
# JSONL event log. Compose sets /app/results/events.jsonl (bind-mounted to ./results).
# EVENTS_PATH=results/events.jsonl
# Mock-ORM sandbox directory (default: ./sandbox).
# SANDBOX_DIR=sandbox

# --- Langfuse (optional distributed tracing) ----------------------------------------------------------------
# Tracing is on when BOTH keys are set (set LANGFUSE_TRACING=false to force it off).
# Local self-hosted Langfuse: run scripts/langfuse_up.sh, which prints these three values (UI: localhost:3000).
# Langfuse Cloud: use your project's keys and LANGFUSE_HOST=https://cloud.langfuse.com (or https://us.cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_TRACING=true
# LANGFUSE_TRACING_ENVIRONMENT=development
# Containers can't reach the host's localhost: compose passes LANGFUSE_DOCKER_HOST (default
# http://host.docker.internal:3000) to the app containers instead of LANGFUSE_HOST. For Langfuse Cloud set it to
# the same URL as LANGFUSE_HOST.
# LANGFUSE_DOCKER_HOST=http://host.docker.internal:3000
